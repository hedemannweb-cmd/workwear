# ─────────────────────────────────────────────────────────────────────────────
# Arbeitskleidungsverwaltung – Umgebungsvariablen
# Kopieren nach .env und Werte ersetzen. .env niemals ins Git-Repository einchecken.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lokale Entwicklung (npm run dev) ─────────────────────────────────────────
# PostgreSQL-Verbindung der Anwendung
DATABASE_URL="postgresql://arbeitskleidung:CHANGE_ME@localhost:5432/arbeitskleidung"
# Separate Datenbank für Integrations- und E2E-Tests (wird von den Tests geleert! Name muss auf _test enden)
TEST_DATABASE_URL="postgresql://arbeitskleidung:CHANGE_ME@localhost:5432/arbeitskleidung_test"

# ── Authentifizierung ────────────────────────────────────────────────────────
# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# Öffentliche Basis-URL, unter der Benutzer die Anwendung aufrufen (in Produktion https://…)
BETTER_AUTH_URL="http://localhost:3000"
# Optional: weitere Adressen, unter denen die Anwendung erreichbar ist (kommagetrennt, mit Protokoll und Port),
# z. B. für den Zugriff von anderen Geräten im Netzwerk
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.20:3000"
# Optional, nur npm run dev: Hostnamen/IPs, von denen aus der Dev-Server genutzt werden darf (kommagetrennt, ohne Protokoll)
# ALLOWED_DEV_ORIGINS="192.168.1.20"
# Optional: max. Anmeldeversuche pro Minute und IP (Standard 10)
# AUTH_SIGNIN_RATE_LIMIT=10

# ── Mailversand (optional, z. B. Mindestbestands-Benachrichtigung) ──────────
# Ohne SMTP_HOST werden keine Mails verschickt. Empfänger: Administration → Einstellungen.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# true nur für Port 465 (TLS ab Verbindungsaufbau), sonst false (STARTTLS)
# SMTP_SECURE="false"
# SMTP_USER="arbeitskleidung@example.com"
# SMTP_PASSWORD="CHANGE_ME"
# Absender, Standard: SMTP_USER
# SMTP_FROM="Arbeitskleidung <arbeitskleidung@example.com>"

# ── Erster Administrator (nur für den Seed, danach aus .env entfernen) ───────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_min_12_Zeichen_Aa1"
# false = keine Demodaten (Produktion)
SEED_DEMO="true"
# Optional: Passwort der Demo-Benutzer manager@/lager@example.com (Standard: SEED_ADMIN_PASSWORD)
# SEED_DEMO_PASSWORD=""

# ── Docker Compose ──────────────────────────────────────────────────────────
POSTGRES_DB="arbeitskleidung"
POSTGRES_USER="arbeitskleidung"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
# Port-Bindung der App auf dem Host (Standard nur lokal erreichbar; hinter Reverse Proxy belassen)
APP_BIND="127.0.0.1"
APP_PORT="3000"
# Hostname für den optionalen Caddy-Reverse-Proxy (docker compose --profile proxy up -d)
APP_DOMAIN="arbeitskleidung.intern"
